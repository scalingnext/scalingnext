# ScalingNext — environment variables
#
# Copy to `.env.local` (gitignored) for local development, and add the same
# values in Vercel → Project Settings → Environment Variables for production.
#
# NEVER commit real values. Only variables prefixed NEXT_PUBLIC_ are exposed to
# the browser; everything else stays server-side.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The `service_role` secret. Bypasses Row Level Security — treat it like a
# database password. Server-only: never add a NEXT_PUBLIC_ prefix to this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gmail (confirmation emails) ───────────────────────────────────────────────
# Requires 2-Step Verification enabled on the account, then:
# Google Account → Security → 2-Step Verification → App passwords
# 16 characters with the spaces removed. NOT the Gmail login password.
GMAIL_USER=scalingnext@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Community invite ──────────────────────────────────────────────────────────
# Public by design; already linked across the site. Optional — the code falls
# back to this exact URL if unset.
NEXT_PUBLIC_WHATSAPP_INVITE_URL=https://chat.whatsapp.com/CKzAuoLtl8w8jzeTWyBWU6

# ── Admin dashboard (/admin) ──────────────────────────────────────────────────
# Password for the /admin login form. Exchanged for a signed httpOnly session
# cookie that lasts 30 days.
# Server-only: never add a NEXT_PUBLIC_ prefix. If unset, /admin returns 503
# rather than falling open. Anyone with this can read every lead's name, email,
# and phone number — treat it accordingly.
# NOTE: this value also signs the session cookie, so changing it immediately
# invalidates every existing login.
ADMIN_PASSWORD=choose-a-strong-password

# ── Agent endpoint (/admin-agent) ─────────────────────────────────────────────
# Bearer token for AI agents reading live site data. Separate from
# ADMIN_PASSWORD so an agent key can be rotated without logging you out, and so
# a leaked agent key never grants dashboard access.
# Generate a strong random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_API_KEY=generate-a-long-random-token
